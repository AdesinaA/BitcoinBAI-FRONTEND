# Frontend environment variables
# Copy this file to .env and adjust values for your local environment.
# Next.js automatically inlines NEXT_PUBLIC_* variables into the client bundle.
#
# NOTE: .env is gitignored — this file documents the required variables.

# Backend API base URL — must match the port the NestJS backend listens on
# (see backend/.env → PORT). Default backend port is 3002.
NEXT_PUBLIC_API_URL=http://localhost:3002/api/v1

# The origin the frontend is served from (used for CORS on the backend).
NEXT_PUBLIC_APP_URL=http://localhost:3000
